# ---------------------------------------------------------------------------
# FEEZEE Fashion — environment
#
# Copy to `.env` and fill in. Everything except DATABASE_URL and SESSION_SECRET
# has a working fallback, so the shop runs end to end on a laptop with only
# those two set.
# ---------------------------------------------------------------------------

# Database — matches docker-compose.yml out of the box.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/feezee?schema=public"

# Optional. The URL the Prisma CLI uses for DDL (db push, migrate, studio);
# falls back to DATABASE_URL when unset. Only needed on a pooled host: on
# Supabase, DATABASE_URL points at port 6543 (pgbouncer, transaction mode)
# for the serverless runtime, and DIRECT_URL at 5432 (session mode), which
# is the one that can carry schema changes.
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/feezee"

# Signs the session cookie. MUST be at least 32 characters, and MUST be
# replaced in production — anyone holding it can mint an admin session.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="dev-only-session-secret-change-me-in-production-please"

# Canonical origin, used in metadata, emails and payment redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payments: Stripe (cards + Apple Pay) ----------------------------------
# Leave blank to hide the card option; COD and bank transfer still work.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Payments: UAE bank transfer -------------------------------------------
# Printed on the order confirmation when the customer picks bank transfer.
BANK_TRANSFER_ACCOUNT_NAME="FEEZEE SILAI FASHION L.L.C"
BANK_TRANSFER_BANK_NAME="Emirates NBD"
BANK_TRANSFER_IBAN="AE000000000000000000000"

# --- Email -----------------------------------------------------------------
# With no key set, every email is written to the server console instead of
# being sent — which is what you want in development.
RESEND_API_KEY=""
EMAIL_FROM="FEEZEE Fashion <orders@feezee.ae>"

# --- Assets ----------------------------------------------------------------
NEXT_PUBLIC_ASSET_BASE=""
